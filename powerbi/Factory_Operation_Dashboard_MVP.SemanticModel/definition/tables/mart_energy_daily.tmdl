table mart_energy_daily
	lineageTag: b8bbc0db-8928-49f0-a14c-43d86b862c5b

	measure 'Total Energy kWh' = SUM ( mart_energy_daily[energy_kwh] )
		formatString: #,0.00
		displayFolder: 01 Core KPIs
		lineageTag: 5faec537-a97e-488f-bee3-de8de840bfc0

	measure 'Total Energy Cost THB' = SUM ( mart_energy_daily[energy_cost_thb] )
		formatString: #,0.00
		displayFolder: 01 Core KPIs
		lineageTag: 407d3ded-6ebc-43e2-94de-dbab5c649533

	measure 'Total Carbon kgCO2e' = SUM ( mart_energy_daily[carbon_kgco2e] )
		formatString: #,0.00
		displayFolder: 01 Core KPIs
		lineageTag: 9b401578-81df-44d0-a8de-fc10664259ee

	measure 'Total Production Units' = SUM ( mart_energy_daily[production_units] )
		formatString: #,0
		displayFolder: 01 Core KPIs
		lineageTag: 1fa24d7d-54b7-464c-b610-9adf902d4d96

	measure 'Energy Intensity kWh per Unit' = DIVIDE ( [Total Energy kWh], [Total Production Units] )
		formatString: #,0.00
		displayFolder: 01 Core KPIs
		lineageTag: b902e613-a9ca-41f2-b553-a75ceac777ce

	measure 'Cost per kWh THB' = DIVIDE ( [Total Energy Cost THB], [Total Energy kWh] )
		formatString: #,0.00
		displayFolder: 01 Core KPIs
		lineageTag: 5192f765-ec3a-462e-bb8f-5c82655b1b68

	measure 'Carbon per Unit kgCO2e' = DIVIDE ( [Total Carbon kgCO2e], [Total Production Units] )
		formatString: #,0.00
		displayFolder: 01 Core KPIs
		lineageTag: 4df27823-2c67-4c27-a2b0-18dc3a269026

	measure 'Target Energy kWh' = SUM ( mart_energy_daily[target_energy_kwh] )
		formatString: #,0.00
		displayFolder: 02 Targets
		lineageTag: b2e42179-a2da-4b79-8990-ee5f2bff9372

	measure 'Target Carbon kgCO2e' = SUM ( mart_energy_daily[target_carbon_kgco2e] )
		formatString: #,0.00
		displayFolder: 02 Targets
		lineageTag: 90418be5-3287-4092-9b0f-661f7ed15ba1

	measure 'Target Energy Intensity' = AVERAGE ( mart_energy_daily[target_energy_intensity] )
		formatString: #,0.00
		displayFolder: 02 Targets
		lineageTag: 02102536-0c71-4eca-995e-5e59d3da6733

	measure 'Energy Variance kWh' = [Total Energy kWh] - [Target Energy kWh]
		formatString: #,0.00
		displayFolder: 02 Targets
		lineageTag: 462fe834-c3d5-4061-a625-c434102a768a

	measure 'Energy Variance %' = DIVIDE ( [Energy Variance kWh], [Target Energy kWh] )
		formatString: 0.00%
		displayFolder: 02 Targets
		lineageTag: a96753c7-a58a-4e77-86f1-479bca9dc0d7

	measure 'Latest Data Date' = MAX ( mart_energy_daily[date] )
		displayFolder: 03 Time Analysis
		lineageTag: 087b1c3f-029c-4779-8654-24663cf6e3e6

	measure 'Energy Today kWh' = VAR LatestDate = CALCULATE ( MAX ( mart_energy_daily[date] ), ALL ( mart_energy_daily[date] ) ) RETURN CALCULATE ( [Total Energy kWh], FILTER ( ALL ( mart_energy_daily[date] ), mart_energy_daily[date] = LatestDate ) )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: faa721a9-1487-463f-b5f9-6553a07834c3

	measure 'Energy Cost Today THB' = VAR LatestDate = CALCULATE ( MAX ( mart_energy_daily[date] ), ALL ( mart_energy_daily[date] ) ) RETURN CALCULATE ( [Total Energy Cost THB], FILTER ( ALL ( mart_energy_daily[date] ), mart_energy_daily[date] = LatestDate ) )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: b8efe62c-deb4-490d-a6dc-88335cedb78d

	measure 'Carbon Today kgCO2e' = VAR LatestDate = CALCULATE ( MAX ( mart_energy_daily[date] ), ALL ( mart_energy_daily[date] ) ) RETURN CALCULATE ( [Total Carbon kgCO2e], FILTER ( ALL ( mart_energy_daily[date] ), mart_energy_daily[date] = LatestDate ) )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: 61b45b4f-7ccf-4edf-bd49-c4e085129063

	measure 'MTD Energy kWh' =
			VAR LatestDate = [Latest Data Date]
			VAR MonthStart = DATE ( YEAR ( LatestDate ), MONTH ( LatestDate ), 1 )
			RETURN
			    CALCULATE (
			        [Total Energy kWh],
			        FILTER (
			            ALL ( 'Dim Date'[Date] ),
			            'Dim Date'[Date] >= MonthStart
			                && 'Dim Date'[Date] <= LatestDate
			        )
			    )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: 89845d62-f8ab-4599-9e1d-819caafcc258

	measure 'MTD Energy Cost THB' =
			VAR LatestDate = [Latest Data Date]
			VAR MonthStart = DATE ( YEAR ( LatestDate ), MONTH ( LatestDate ), 1 )
			RETURN
			    CALCULATE (
			        [Total Energy Cost THB],
			        FILTER (
			            ALL ( 'Dim Date'[Date] ),
			            'Dim Date'[Date] >= MonthStart
			                && 'Dim Date'[Date] <= LatestDate
			        )
			    )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: 2a4ff3ba-a23d-40b3-8cf7-136c04903060

	measure 'MTD Carbon kgCO2e' =
			VAR LatestDate = [Latest Data Date]
			VAR MonthStart = DATE ( YEAR ( LatestDate ), MONTH ( LatestDate ), 1 )
			RETURN
			    CALCULATE (
			        [Total Carbon kgCO2e],
			        FILTER (
			            ALL ( 'Dim Date'[Date] ),
			            'Dim Date'[Date] >= MonthStart
			                && 'Dim Date'[Date] <= LatestDate
			        )
			    )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: a0f50369-1966-4fe6-b07d-f327e7dc76b2

	measure 'Previous Month Energy kWh' = CALCULATE ( [Total Energy kWh], DATEADD ( 'Dim Date'[Date], -1, MONTH ) )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: ba18fd15-799c-484b-a52e-a1907f42153a

	measure 'Energy vs Previous Month %' = DIVIDE ( [Total Energy kWh] - [Previous Month Energy kWh], [Previous Month Energy kWh] )
		formatString: 0.00%
		displayFolder: 03 Time Analysis
		lineageTag: fa188853-3fb4-416c-8a02-03c4a1b491ff

	measure 'Energy Daily Row Count' = COUNTROWS ( mart_energy_daily )
		formatString: #,0
		displayFolder: 99 Validation
		lineageTag: daf62922-8cc0-4364-900a-d8631c77bcfb

