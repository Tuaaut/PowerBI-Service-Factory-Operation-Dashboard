table mart_energy_projects
	lineageTag: 9eafbd00-5028-43ea-aa71-743dbbd43d7d

	measure 'Project Count' = COUNTROWS ( mart_energy_projects )
		formatString: #,0
		displayFolder: 07 Projects
		lineageTag: 247039c5-1172-469e-93c6-d60a658d7537

	measure 'Active Project Count' = CALCULATE ( [Project Count], mart_energy_projects[status] <> "Completed" )
		formatString: #,0
		displayFolder: 07 Projects
		lineageTag: a9f8dda4-83b1-4bb7-8994-4c8562abbb49

	measure 'Average Project Progress %' = AVERAGE ( mart_energy_projects[progress_pct] )
		formatString: 0.00%
		displayFolder: 07 Projects
		lineageTag: c67f8510-e175-4091-b76b-c5c8329b0395

	measure 'Expected Annual Saving THB' = SUM ( mart_energy_projects[expected_annual_saving_thb] )
		formatString: #,0.00
		displayFolder: 07 Projects
		lineageTag: 9035a350-94fd-4a5b-837e-d3e5300f57fd

	measure 'Completed Project Count' = CALCULATE ( [Project Count], mart_energy_projects[status] = "Completed" )
		formatString: #,0
		displayFolder: 07 Projects
		lineageTag: 4c4c2eab-daea-4118-a43f-5a0409f04298

