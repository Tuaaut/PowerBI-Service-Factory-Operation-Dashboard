table mart_energy_hourly
	lineageTag: 02770248-ade2-442d-841b-bb5817546daf

	measure 'Hourly Energy kWh' = SUM ( mart_energy_hourly[energy_kwh] )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: 744cac66-5243-4fbf-9a3d-697a49065c30

	measure 'Hourly Forecast kWh' = SUM ( mart_energy_hourly[forecast_kwh] )
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: f8742762-a940-4b84-8c0f-cb7b1a94833a

	measure 'Hourly Forecast Variance kWh' = [Hourly Energy kWh] - [Hourly Forecast kWh]
		formatString: #,0.00
		displayFolder: 03 Time Analysis
		lineageTag: 42398239-3164-489f-9f28-8c006249c1fc

	measure 'Hourly Forecast Variance %' = DIVIDE ( [Hourly Forecast Variance kWh], [Hourly Forecast kWh] )
		formatString: 0.00%
		displayFolder: 03 Time Analysis
		lineageTag: 0dfd00f7-25d9-4118-bfbb-dd49e2b7a500

