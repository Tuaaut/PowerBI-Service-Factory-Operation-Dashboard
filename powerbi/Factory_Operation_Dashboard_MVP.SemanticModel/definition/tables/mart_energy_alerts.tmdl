table mart_energy_alerts
	lineageTag: b75d8982-0ecf-41f5-8a13-1e15fda0fe95

	measure 'Alert Count' = COUNTROWS ( mart_energy_alerts )
		formatString: #,0
		displayFolder: 06 Alerts
		lineageTag: b6720619-c5bb-48b2-bf47-cab3ae3e76e5

	measure 'Open Alert Count' = CALCULATE ( [Alert Count], mart_energy_alerts[status] <> "Closed" )
		formatString: #,0
		displayFolder: 06 Alerts
		lineageTag: f5ac89ab-d01d-44c2-970f-d9b6b0f50b38

	measure 'Critical Alert Count' = CALCULATE ( [Alert Count], mart_energy_alerts[severity] = "Critical", mart_energy_alerts[status] <> "Closed" )
		formatString: #,0
		displayFolder: 06 Alerts
		lineageTag: 109d500f-932a-47cb-ac83-87a2b3c8fb1d

	measure 'Warning Alert Count' = CALCULATE ( [Alert Count], mart_energy_alerts[severity] = "Warning", mart_energy_alerts[status] <> "Closed" )
		formatString: #,0
		displayFolder: 06 Alerts
		lineageTag: 938b47c5-52b9-4c37-acc5-28d3bf5d5f2b

	measure 'Alert Row Count' = COUNTROWS ( mart_energy_alerts )
